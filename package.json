{
  "name": "pjs-workspace",
  "private": true,
  "version": "1.0.0-rc.4",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc -p packages/runtime/tsconfig.json",
    "typecheck:compat": "tsc6 --noEmit -p packages/runtime/tsconfig.json",
    "test": "npm run build && npm run test:types && node --test --test-timeout=20000 packages/runtime/test/*.test.mjs",
    "test:types": "tsc -p packages/runtime/test/tsconfig.json",
    "test:stress": "npm run build && node scripts/stress.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:cpu": "npm run build && node benchmarks/cpu-baseline/run.mjs",
    "benchmark:matrix": "npm run build && node benchmarks/matrix-multiplication/run.mjs",
    "benchmark:transfer": "npm run build && node benchmarks/transfer/run.mjs",
    "example": "npm run build && node examples/prime-search.mjs",
    "example:transfer": "npm run build && node examples/transfer.mjs",
    "benchmark:shared": "npm run build && node benchmarks/shared-memory/run.mjs",
    "benchmark:matrix:shared": "npm run build && node benchmarks/shared-memory/run.mjs matrix",
    "benchmark:piscina": "npm run build && node benchmarks/shared-memory/run.mjs piscina",
    "benchmark:partition": "npm run build && node benchmarks/partitioning/run.mjs",
    "benchmark:dispatch": "npm run build && node benchmarks/dispatch-efficiency/run.mjs",
    "benchmark:completion": "npm run build && node benchmarks/completion-only/run.mjs && node benchmarks/completion-only/fairness.mjs",
    "benchmark:stream": "npm run build && node benchmarks/streaming/run.mjs && node benchmarks/streaming/fairness.mjs",
    "benchmark:map": "npm run build && node benchmarks/mapping/run.mjs && node benchmarks/mapping/pipeline.mjs && node benchmarks/mapping/fairness.mjs",
    "benchmark:binary": "npm run build && node benchmarks/binary-results/run.mjs && node benchmarks/binary-results/fairness.mjs",
    "benchmark:reservation": "npm run build && node benchmarks/reservation-audit/run.mjs && node benchmarks/reservation-audit/pipeline.mjs",
    "benchmark:upper-bound": "npm run build && node benchmarks/upper-bound-results/run.mjs && node benchmarks/upper-bound-results/refund.mjs && node benchmarks/upper-bound-results/profile.mjs",
    "soak:reservations:smoke": "npm run build && node scripts/reservation-soak.mjs --mode=smoke",
    "soak:reservations": "npm run build && node scripts/reservation-soak.mjs --mode=quick",
    "test:contracts": "npm run build && node scripts/test-contracts.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "example:basic": "npm run build && node examples/basic-run.mjs",
    "test:rc:api": "npm run build && node scripts/rc/api-freeze.mjs",
    "test:rc:package": "npm run build && node scripts/rc/package.mjs",
    "soak:rc:smoke": "npm run build && node scripts/rc/soak.mjs --profile=smoke",
    "soak:rc": "npm run build && node scripts/rc/soak.mjs --profile=standard",
    "rc:qualify": "node scripts/rc/qualify.mjs",
    "rc:repro": "node scripts/rc/repro.mjs",
    "benchmark:flagship:test": "node --test --test-timeout=20000 benchmarks/flagship-monte-carlo/harness.test.mjs && node benchmarks/flagship-monte-carlo/run.mjs test",
    "benchmark:flagship:smoke": "node benchmarks/flagship-monte-carlo/run.mjs smoke",
    "benchmark:flagship:calibrate": "node benchmarks/flagship-monte-carlo/run.mjs calibrate",
    "benchmark:flagship:full": "node benchmarks/flagship-monte-carlo/run.mjs full",
    "benchmark:flagship:analyze": "node benchmarks/flagship-monte-carlo/analyze.mjs",
    "test:release": "node --test scripts/release/npm-release.test.mjs scripts/release/npm-cli.test.mjs",
    "release:npm": "node scripts/release/toolchain.mjs provision"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "piscina": "5.3.2",
    "prettier": "^3.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.48.0"
  }
}
